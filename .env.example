# Copy this file to .env and never commit .env.
POSTGRES_PASSWORD=change-me
# The port Postgres uses on your computer. If another Postgres already uses 5432,
# pick another port (for example 5433) here AND in DATABASE_URL below.
ERRAND_DB_PORT=5432
DATABASE_URL=postgres://errand:change-me@127.0.0.1:5432/errand
PRACTICE_API_URL=http://127.0.0.1:4010
PRACTICE_API_KEY=pk_practice_0123456789abcdefghijklmn
PORT=3000
